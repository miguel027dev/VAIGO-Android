<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vienna" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/vienna_bg</item>
        <item name="android:navigationBarColor">@color/vienna_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/vienna_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_vienna_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">180</item>
        <item name="android:colorAccent">@color/vienna_primary</item>
        <item name="android:windowBackground">@color/vienna_bg</item>
    </style>
</resources>
